## .NET / C# gitignore

# Build results
bin/
obj/
out/

# Visual Studio / Rider / VS Code cache
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# Rider
.idea/
*.sln.iml

# macOS
.DS_Store

# Publish / deployment
*.publishsettings
PublishScripts/
publish/

# Environment / secrets
appsettings.Development.json
.env
